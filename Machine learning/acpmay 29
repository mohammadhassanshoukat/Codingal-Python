def find_subsequences(s):
    n = len(s)
   
    for i in range(1, 1 << n):
        subsequence = ""
        for j in range(n):
           
            if (i & (1 << j)):
                subsequence += s[j]
        print(subsequence)


input_str = input("Enter string : ")
find_subsequences(input_str)
